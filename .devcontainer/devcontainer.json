{
  "name": "homelab-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install --user uv==0.11.32 && uv sync && uv run pre-commit install && cp -n .env.example .env && cp -n config.example.yaml config.yaml || true",
  "forwardPorts": [8099],
  "portsAttributes": {
    "8099": { "label": "Panneau (make dev : mot de passe dev-password-123)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "yaml.schemas": { "./config.schema.json": ["config*.yaml", "deploy/config*.yaml"] }
      }
    }
  }
}
