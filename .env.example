# Copier en .env :  cp .env.example .env   (ne JAMAIS committer .env)
# --- Telegram : token donné par @BotFather
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME
# --- Home Assistant : token longue durée
HA_TOKEN=REPLACE_ME
# --- Panneau web (8 caractères minimum)
PANEL_PASSWORD=change-me-please
# --- Cloud (facultatif, facturé à l'usage, voir docs/cloud-budget.md)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# --- Hugging Face (facultatif, pour les dépôts protégés)
HF_TOKEN=

# --- Docker Compose
# Port du panneau sur l'hôte (lié à 127.0.0.1 uniquement)
PANEL_PORT=8099
# Plafond mémoire du moteur CPU (14B Q4 ≈ 9 Go + contexte)
LLAMA_CPU_MEM_LIMIT=12g
# Dossier des modèles sur l'hôte
MODELS_DIR=./models
# Image de base CUDA du moteur GPU (driver 535 → CUDA 12.2). Voir docs/gpu-sharing.md
CUDA_VERSION=12.2.2
# Architecture CUDA ciblée à la compilation (86 = RTX 30xx). Plusieurs : "75;86"
CUDA_ARCHITECTURES=86
